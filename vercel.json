{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/gateway.js": {
      "includeFiles": "{server,shared}/**",
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/api/gateway", "destination": "/api/gateway" },
    { "source": "/api/:path*", "destination": "/api/gateway" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
